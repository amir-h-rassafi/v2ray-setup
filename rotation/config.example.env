# Copy to config.env (git-ignored) and fill in. Never commit real values.
# --- provider APIs (secrets: keep in files outside the repo, chmod 600) ---
UPCLOUD_CRED_FILE=/path/to/secrets/upcloud_api      # contains: user=...  pass=...
CF_TOKEN_FILE=/path/to/secrets/cf_token             # Cloudflare API token (Zone.DNS:Edit)
CF_ZONE_ID=your-zone-id
SSH_KEY=~/.ssh/vpn-rotator                          # private key with root access to the node
# --- names ---
DIRECT_HOST=direct.example.com      # DNS-only record (REALITY, ACME renewals)
CDN_HOST=cdn.example.com            # proxied (orange-cloud) record for CDN inbounds + subscriptions
NODE_PREFIX=vpn-                    # servers are named <prefix><zone>
CLEAN_EDGE_IP=203.0.113.10          # a CDN edge IP that is reachable from your users' networks
ECH_CONFIG=cloudflare-ech.com+https://1.1.1.1/dns-query
# --- server ---
PLAN=STARTER-1xCPU-1GB
DISK_GB=10
ROTATION=de-fra1,se-sto1,nl-ams1,fi-hel1,dk-cph1,es-mad1,no-svg1,pl-waw1,uk-lon1
BACKUP_DIR=./backups
BACKUP_KEEP=14
